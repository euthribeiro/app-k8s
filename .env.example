# Variáveis de execução local. Copie para .env e preencha.
# O .env NÃO é versionado — nenhum segredo entra no repositório.

# Chave de assinatura do JWT. Em produção vem do secret JWT_SIGNING_KEY do
# pipeline; localmente gere uma qualquer, por exemplo:
#   openssl rand -hex 32
JWT_SIGNING_KEY=

# Credenciais do administrador semeado na primeira subida.
ADMIN_EMAIL=admin@wrench.com.br
ADMIN_PASSWORD=
